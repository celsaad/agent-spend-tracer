# Base Sepolia RPC endpoint (the public one is rate-limited; swap in Alchemy/Infura/etc. if needed)
RPC_URL=https://sepolia.base.org

# 0x-prefixed private key for the agent's wallet. TESTNET ONLY: never put a funded mainnet key here.
AGENT_PRIVATE_KEY=0x

# Optional
API_PORT=3001
DATABASE_PATH=./data.db

# Optional: address the seeded demo mandate pays (defaults to the agent wallet itself)
# DEMO_RECIPIENT=0x

# Optional: indexer settings. Transfers are confirmed once this many blocks deep (default 5, ~10s
# on Base). On a fresh database the indexer starts at the current block unless a start is given.
# INDEXER_CONFIRMATIONS=5
# INDEXER_START_BLOCK=
# Blocks per eth_getLogs request (default 200, the public RPC's limit; raise it on a paid RPC)
# INDEXER_CHUNK_SIZE=200
