# Base Sepolia RPC endpoint (the public one is rate-limited; swap in Alchemy/Infura/etc. if needed)
RPC_URL=https://sepolia.base.org

# 0x-prefixed private key for the agent's wallet. TESTNET ONLY: never put a funded mainnet key here.
AGENT_PRIVATE_KEY=0x

# Optional
API_PORT=3001
DATABASE_PATH=./data.db
